{
  // Tells the Microsoft C/C++ extension how to understand the code
  // (red squiggles, go-to-definition). Not used for building.
  "configurations": [
    {
      "name": "Mac",
      "includePath": ["${workspaceFolder}/include", "${workspaceFolder}/tests", "${workspaceFolder}/bench"],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "macos-clang-arm64"
    }
  ],
  "version": 4
}
